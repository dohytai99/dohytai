<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trang Web Của Bạn</title>
  <style>
    /* CSS để video YouTube có chiều rộng đầy đủ và tỷ lệ 16:9 */
    .responsive-video {
      width: 100%;
      aspect-ratio: 16 / 9;
      height: auto;
    }
  </style>
</head>
<body>
  <!-- Nhúng video YouTube với chiều rộng đầy đủ -->
  <iframe
    src="https://www.youtube.com/embed/GQjuEygcS3A"
    title="YouTube video player"
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    class="responsive-video">
  </iframe>
</body>
</html>
